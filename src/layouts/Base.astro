---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import monoLatin from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import { enabledLangs, languages, localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of this page without language prefix, used for the language switcher. */
  path?: string;
  showContactLink?: boolean;
}

const { lang, title, description, path = '/', showContactLink = true } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} | ${t('meta.title')}` : t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(localePath(lang, path), Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/brand/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {enabledLangs.length > 1 &&
      enabledLangs.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), Astro.site)} />
      ))}
    <slot name="head" />
  </head>
  <body>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="page">
      <header class="site-header">
        <a href={localePath(lang, '/')} class="home-link" aria-label={t('nav.home')}>
          <Logo height={44} eager />
        </a>
        <nav class="site-nav mono">
          {showContactLink && <a href={localePath(lang, '/contact')}>{t('nav.contact')}</a>}
          {enabledLangs.length > 1 && (
            <span class="langs" role="group" aria-label={t('nav.language')}>
              {enabledLangs.map((l, i) => (
                <>
                  {i > 0 && <span class="sep" aria-hidden="true">/</span>}
                  <a
                    href={localePath(l, path)}
                    hreflang={l}
                    lang={l}
                    aria-current={l === lang ? 'true' : undefined}
                    title={languages[l]}
                  >
                    {l.toUpperCase()}
                  </a>
                </>
              ))}
            </span>
          )}
        </nav>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer mono">
        <span>JLco</span>
        <span>© {year}</span>
      </footer>
    </div>
  </body>
</html>

<style>
  .grid-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(0, 139, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 139, 255, 0.07) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 30% 40%, #000 30%, transparent 85%);
  }
  .page {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    padding: 0 var(--gutter);
  }
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding: 32px 0;
  }
  .home-link { text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 13px;
  }
  .site-nav a { text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .langs { display: inline-flex; gap: 6px; align-items: center; }
  .langs a:not([aria-current]) { color: var(--faint); }
  .langs a:hover { color: var(--accent-2); }
  .sep { color: var(--line-2); }
  .site-main { flex-grow: 1; display: flex; flex-direction: column; }
  .site-footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--faint);
  }
</style>
