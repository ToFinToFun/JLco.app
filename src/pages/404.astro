---
import Base from '../layouts/Base.astro';
import { defaultLang, localePath, useTranslations } from '../i18n/ui';

const lang = defaultLang;
const t = useTranslations(lang);
---
<Base lang={lang} title="404">
  <section class="nf">
    <p class="eyebrow">// 404</p>
    <h1 class="display">{t('notfound.title')}</h1>
    <div><a class="button" href={localePath(lang, '/')}>{t('notfound.back')}</a></div>
  </section>
</Base>

<style>
  .nf { flex-grow: 1; display: flex; flex-direction: column; justify-content: center; gap: 32px; padding: 48px 0 72px; }
  .nf p { margin: 0; }
  h1 { font-size: clamp(40px, 6vw, 88px); line-height: 1; }
</style>
