---
import Base from '../../layouts/Base.astro';
import { langPaths, localePath, useTranslations, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<Base lang={lang} path="/" showContactLink={true}>
  <section class="hero">
    <p class="eyebrow">{t('home.eyebrow')}</p>
    <h1 class="display">{t('home.title')}</h1>
    <p class="lead">{t('home.lead')}</p>
    <div>
      <a class="button" href={localePath(lang, '/contact')}>
        {t('home.cta')} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 36px;
    max-width: 1100px;
    padding: 48px 0 72px;
  }
  .hero p { margin: 0; }
  h1 {
    font-size: clamp(44px, 7.4vw, 112px);
    line-height: 0.95;
  }
  .lead {
    max-width: 560px;
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.55;
    color: var(--muted);
  }
</style>
