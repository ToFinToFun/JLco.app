# SMTP on your own mail server. Create a dedicated sender account for the site.
SMTP_HOST=mail.paasovaara.se
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=noreply@jlco.se
SMTP_PASS=
# Sender shown on the email, normally the same account as SMTP_USER
SMTP_FROM="JLco website <noreply@jlco.se>"
# Where contact messages are delivered. Never sent to the browser.
CONTACT_TO=info@jlco.se

# Cloudflare Turnstile (optional in development; the check is skipped when empty)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: secret for signing the contact form timestamp (defaults to one derived from SMTP_PASS)
FORM_SECRET=
